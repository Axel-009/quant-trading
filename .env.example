# Quant Trading Environment Variables
# Copy this file to .env and configure your settings

# Data directory (optional - defaults to ./data)
# QUANT_DATA_DIR=/path/to/your/data

# Preview/charts directory (optional - defaults to ./preview)
# QUANT_PREVIEW_DIR=/path/to/your/preview

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Keys (optional - only if you need premium data sources)
# ALPHA_VANTAGE_API_KEY=your_key_here
# QUANDL_API_KEY=your_key_here

# Note: Never commit .env file to git!
# Add .env to .gitignore
